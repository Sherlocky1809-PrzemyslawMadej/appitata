SUPABASE_URL=###
SUPABASE_KEY=###
# Service-role key — used ONLY by the Cloudflare scheduled() cron handler to run
# the invitation-expiry sweep (bypasses RLS). Never expose to the client/request path.
# Local value: the `service_role key` from `npx supabase status`.
# Production: set via `npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY` (human-only).
SUPABASE_SERVICE_ROLE_KEY=###