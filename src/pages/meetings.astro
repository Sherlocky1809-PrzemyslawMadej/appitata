---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import MeetingCreateForm from "@/components/meetings/MeetingCreateForm";
import MeetingsList from "@/components/meetings/MeetingsList";
import PendingInvitationsList from "@/components/meetings/PendingInvitationsList";
import type { ClashingMeetingSummary, MeetingRow, PendingInvitation } from "@/components/meetings/types";

// Middleware guarantees `user` is non-null on this protected route — see src/middleware.ts.
const user = Astro.locals.user;

let friends: { id: string; display_name: string | null }[] = [];
let meetings: MeetingRow[] = [];
let pendingInvitations: PendingInvitation[] = [];
let upcoming: MeetingRow[] = [];
let past: MeetingRow[] = [];
let conflictsByInvitationId: Record<string, ClashingMeetingSummary[]> = {};
let loadError: string | null = null;
const viewerId = user?.id ?? "";

const supabase = user ? createClient(Astro.request.headers, Astro.cookies) : null;

function endsAt(m: { starts_at: string; duration_minutes: number }): number {
  return new Date(m.starts_at).getTime() + m.duration_minutes * 60_000;
}

if (!user) {
  loadError = "Not signed in";
} else if (!supabase) {
  loadError = "Supabase is not configured";
} else {
  const [friendsRes, meetingsRes] = await Promise.all([
    supabase.rpc("list_my_friends"),
    supabase
      .from("meetings")
      .select(
        "id, starts_at, duration_minutes, street, city, postal_code, country, description, created_at, creator:parents!creator_id(id, display_name), invitations:meeting_invitations(id, status, invited_at, responded_at, invitee:parents!invitee_id(id, display_name))",
      )
      .order("starts_at", { ascending: true }),
  ]);

  if (friendsRes.error) loadError = friendsRes.error.message;
  else if (meetingsRes.error) loadError = meetingsRes.error.message;
  else {
    friends = friendsRes.data;
    meetings = meetingsRes.data;

    const now = Date.now();

    const freshnessCutoff = now - 24 * 60 * 60 * 1000;

    pendingInvitations = meetings.flatMap((m) => {
      const inv = m.invitations.find(
        (i) =>
          i.invitee?.id === viewerId && i.status === "pending" && new Date(i.invited_at).getTime() > freshnessCutoff,
      );
      return inv ? [{ invitation_id: inv.id, meeting: m }] : [];
    });

    const myScheduleForConflicts = meetings.filter(
      (m) =>
        m.creator?.id === viewerId || m.invitations.some((i) => i.invitee?.id === viewerId && i.status === "accepted"),
    );

    upcoming = myScheduleForConflicts.filter((m) => endsAt(m) >= now);
    past = myScheduleForConflicts
      .filter((m) => endsAt(m) < now)
      .slice()
      .sort((a, b) => new Date(b.starts_at).getTime() - new Date(a.starts_at).getTime());

    conflictsByInvitationId = Object.fromEntries(
      pendingInvitations.map((pi) => {
        const piStart = new Date(pi.meeting.starts_at).getTime();
        const piEnd = endsAt(pi.meeting);
        const clashes: ClashingMeetingSummary[] = myScheduleForConflicts
          .filter((m) => m.id !== pi.meeting.id)
          .filter((m) => {
            const mStart = new Date(m.starts_at).getTime();
            const mEnd = endsAt(m);
            return mStart < piEnd && mEnd > piStart;
          })
          .map((m) => ({ id: m.id, starts_at: m.starts_at, duration_minutes: m.duration_minutes }));
        return [pi.invitation_id, clashes];
      }),
    );
  }
}
---

<Layout title="Meetings">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-3xl space-y-6 py-8">
      <header class="flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Meetings
        </h1>
        <a href="/dashboard" class="text-sm text-blue-100/80 hover:underline">← Dashboard</a>
      </header>

      {
        loadError ? (
          <div class="rounded-lg border border-red-400/40 bg-red-500/10 p-4 text-sm text-red-200">
            Failed to load meetings: {loadError}
          </div>
        ) : null
      }

      <section class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <h2 class="mb-4 text-lg font-semibold">Create new meeting</h2>
        <MeetingCreateForm friends={friends} client:load />
      </section>

      <section class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <h2 class="mb-4 text-lg font-semibold">Pending invitations</h2>
        <PendingInvitationsList invitations={pendingInvitations} conflicts={conflictsByInvitationId} client:visible />
      </section>

      <section class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <h2 class="mb-4 text-lg font-semibold">Upcoming meetings</h2>
        <MeetingsList meetings={upcoming} viewerId={viewerId} emptyMessage="No upcoming meetings." client:visible />
      </section>

      <section class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
        <h2 class="mb-4 text-lg font-semibold">Past meetings</h2>
        <MeetingsList meetings={past} viewerId={viewerId} emptyMessage="No past meetings." client:visible />
      </section>
    </div>
  </div>
</Layout>
